# W03 실행 환경변수 예시 — 이 파일을 .env 로 복사하지 말고, 값은 셸 환경변수로만 넣으세요(키 값을 파일·저장소에 남기지 않음).
# 키가 없어도 앱은 동작하며, AI 단계는 '요약 실패 - 수동 작성' / 사람 구조화 폼 경로로 넘어갑니다.

# AI 공급자: gemini 이면 Gemini, 비우면 Anthropic Claude
AI_PROVIDER=gemini
# AI_PROVIDER=gemini 일 때 필요
GEMINI_API_KEY=
# 기본 gemini-3.5-flash-lite (무료 등급 Flash-Lite)
GEMINI_MODEL=gemini-3.5-flash-lite
# Claude(claude-opus-5-5)를 쓸 때 필요
ANTHROPIC_API_KEY=

# 실행 상태 DB 위치(기본: 임시 폴더). 재시작해도 입력을 보존하려면 지워지지 않는 경로로 지정
# W03_DB=C:\w03\state.db
# 빈 DB로 시작하면 시작 상태(업무일 2026-07-01 · 판정 · 회수상신 #1)를 자동 생성. 0이면 끔(테스트용)
W03_AUTOSEED=1
